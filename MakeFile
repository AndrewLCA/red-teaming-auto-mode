PYTHON = uv run --project simulation --no-dev python
GRAPH_SCRIPT = simulation/src/auto_mode_eval/monitor/dependencyGraph/dependency_graph.py
EVAL_SCRIPT = simulation/example/multicontext.py

FILE ?= simulation/example/mctest4.yaml
MONITOR ?= dependency
CONTEXT ?= 1
MESSAGE ?= 4

EXPECTED ?= BLOCK

transcript = $(word 2,$(MAKECMDGOALS))

.PHONY: eval graph

eval:
ifneq ($(strip $(EXPECTED)),BLOCK)
	$(error Current multicontext.py only supports EXPECTED=BLOCK)
endif
	@echo Evaluating $(FILE) using $(MONITOR) monitor. Expected: $(EXPECTED)
	$(PYTHON) "$(EVAL_SCRIPT)" --yaml "$(FILE)" --monitor "$(MONITOR)" --context $(CONTEXT) --message $(MESSAGE)

graph:
ifeq ($(strip $(transcript)),)
	$(error Usage: make graph path/to/transcript.jsonl)
endif
	$(PYTHON) "$(GRAPH_SCRIPT)" "$(transcript)" \
		-o "$(dir $(transcript))$(basename $(notdir $(transcript)))_dependency_graph.json" \
		--nodes-output "$(dir $(transcript))$(basename $(notdir $(transcript)))_tool_nodes.json"

%:
	@:
